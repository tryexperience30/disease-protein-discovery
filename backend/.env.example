# Comma-separated browser origins allowed to call the API.
# Local defaults are used when this is unset.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production example (set in the Render dashboard, do not commit real URLs):
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Optional. Allow Vercel preview URLs without a full wildcard.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGIN_REGEX=
